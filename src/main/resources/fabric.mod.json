{
	"schemaVersion": 1,
	"id": "nivium",
	"version": "${version}",
	"name": "Nivium",
	"description": "Smoother Minecraft for players on any server: one-click FPS boost, an FPS/ping/TPS overlay, and a lag check that tells you whether lag comes from your PC, the server or your connection. Client-only.",
	"authors": [
		"AbsentsPlayz"
	],
	"contact": {
		"sources": "https://github.com/AbsentsPlayz/nivium",
		"issues": "https://github.com/AbsentsPlayz/nivium/issues"
	},
	"license": "LGPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.nivium.client.NiviumClient"
		]
	},
	"mixins": [
		{
			"config": "nivium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"sodium": "*"
	}
}
