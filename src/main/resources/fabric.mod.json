{
	"schemaVersion": 1,
	"id": "nivium",
	"version": "${version}",
	"name": "Nivium",
	"description": "Advanced Minecraft Server Optimization: continuous tick monitoring, spike attribution and adaptive simulation distance. Server-side; players do not need it.",
	"authors": [
		"AbsentsPlayz"
	],
	"contact": {
		"sources": "https://github.com/AbsentsPlayz/nivium",
		"issues": "https://github.com/AbsentsPlayz/nivium/issues"
	},
	"license": "LGPL-3.0-only",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.nivium.Nivium"
		],
		"client": [
			"io.github.nivium.client.NiviumClient"
		]
	},
	"mixins": [
		{
			"config": "nivium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"lithium": "*"
	}
}
